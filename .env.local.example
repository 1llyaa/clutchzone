# Supabase (Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Phase 2)
RESEND_API_KEY=

# SMTP — admin notification emails (same provider as Supabase Auth SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown in the email ("Clutch Zone <noreply@clutchzone.cz>")
SMTP_FROM=
# Where new-reservation notifications get delivered
ADMIN_NOTIFY_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=https://clutchzone.club

# JSON-LD LocalBusiness (src/components/seo/JsonLd.tsx) — all optional, omitted if unset
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_BUSINESS_ICO=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# HMAC key for the signed self-service links in confirmation emails (cancel a
# booking, withdraw from a credit purchase). Server-only: never prefix with
# NEXT_PUBLIC_. Any long random string, e.g. `openssl rand -base64 32`.
# Unset = bookings/purchases still work, the emails just omit those links.
# Rotating it invalidates every link already sent out.
BOOKING_CANCEL_SECRET=

# Maintenance mode — gate whole site behind styled login page
MAINTENANCE_MODE=false
MAINTENANCE_USER=
MAINTENANCE_PASS=

# ggLeap — public API token (ggLeap web admin → Settings → API)
# Server-only: never prefix with NEXT_PUBLIC_. Unset = hours lookup degrades to
# "nelze ověřit" and checkout still works.
GGLEAP_AUTH_TOKEN=
